    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "10.6.2",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "eslint": "10.14.0",
